generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Subject {
  id       String         @id @default(cuid())
  name     String
  sessions StudySession[]
}

model StudySession {
  id        String  @id @default(cuid())
  duration  Int
  notes     String?
  subject   Subject @relation(fields: [subjectId], references: [id])
  subjectId String
}
